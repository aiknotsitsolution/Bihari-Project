{
  "name": "ecommerce-nest-microservices",
  "version": "1.0.0",
  "private": true,
  "description": "E-commerce backend: NestJS microservices + PostgreSQL",
  "scripts": {
    "build": "nest build gateway && nest build auth-service && nest build catalog-service && nest build order-service && nest build payment-service",
    "start:dev:gateway": "nest start gateway --watch",
    "start:dev:auth": "nest start auth-service --watch",
    "start:dev:catalog": "nest start catalog-service --watch",
    "start:dev:order": "nest start order-service --watch",
    "start:dev:payment": "nest start payment-service --watch",
    "start:all": "concurrently -n gw,auth,cat,ord,pay \"npm:start:dev:gateway\" \"npm:start:dev:auth\" \"npm:start:dev:catalog\" \"npm:start:dev:order\" \"npm:start:dev:payment\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.6",
    "@nestjs/microservices": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "ts-loader": "^9.6.2",
    "typescript": "~5.7.2"
  }
}
