# ---------- PostgreSQL (one database per service, same server) ----------
# Set DATABASE_URL for Neon. Each service then uses its own schema in that database.
# Keep the actual credentials in .env (never commit them).
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
AUTH_DB=auth_db
CATALOG_DB=catalog_db
ORDER_DB=order_db
PAYMENT_DB=payment_db
# true = TypeORM auto-creates tables (dev only). Use migrations in production!
DB_SYNC=true

# ---------- Security ----------
# same value in gateway + auth-service
JWT_SECRET=asdfghjkjhgfrertyuit4567ufghjfghj
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_DAYS=7
# secret the payment gateway/webhook must send in the x-webhook-secret header
PAYMENT_WEBHOOK_SECRET=change-me-too

# first admin account, created on auth-service start-up
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# ---------- Service discovery (TCP transport) ----------
GATEWAY_PORT=8000
GATEWAY_HOST_PORT=8080
AUTH_HOST=localhost
AUTH_PORT=8001
CATALOG_HOST=localhost
CATALOG_PORT=8002
ORDER_HOST=localhost
ORDER_PORT=8003
PAYMENT_HOST=localhost
PAYMENT_PORT=8004

CORS_ORIGINS=http://localhost:3000
